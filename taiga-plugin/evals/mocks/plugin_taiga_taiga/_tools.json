    },
    {
      "name": "taiga_comment_add",
      "description": "Add a comment to a user story, task, issue or epic.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": [
              "string",
              "number"
            ],
            "description": "Project id or slug."
          },
          "resource": {
            "type": "string",
            "enum": [
              "userstory",
              "task",
              "issue",
              "epic"
            ],
            "description": "Which kind of item the comment belongs to."
          },
          "id": {
            "type": "number",
            "description": "Internal item id."
          },
          "ref": {
            "type": "number",
            "description": "The #number shown in Taiga."
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "description": "Comment text (Markdown)."
          }
        },
        "required": [
          "resource",
          "comment"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "taiga_bulk_create",
      "description": "Create up to 50 user stories, tasks or issues in one call. Each item is created independently: a failure in one does not stop the rest. Show the user the plan before calling this.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": [
              "string",
              "number"
            ],
            "description": "Project id or slug."
          },
          "resource": {
            "type": "string",
            "enum": [
              "userstory",
              "task",
              "issue"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            },
            "minItems": 1,
            "description": "Items to create. Each takes the same fields as the matching taiga_<resource>_create tool, e.g. {subject, description, status, tags}."
          }
        },
        "required": [
          "resource",
          "items"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "anthropic/requiresUserInteraction": true
      }
    },
    {
      "name": "taiga_stats",
      "description": "Progress statistics. With `sprint` it returns that sprint's points, completed work and a day-by-day burndown series. Without it, project-wide totals and velocity.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": [
              "string",
              "number"
            ],
            "description": "Project id or slug."
          },
          "sprint": {
            "type": "string",
            "description": "Sprint name, e.g. 'Sprint 2'. Omit for project-wide stats."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ]
