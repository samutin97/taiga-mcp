          },
          "severity": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "assigned_to": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tag names."
          },
          "due_date": {
            "type": "string"
          }
        },
        "required": [
