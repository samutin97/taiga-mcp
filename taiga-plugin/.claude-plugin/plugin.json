{
  "name": "taiga",
  "version": "0.1.0",
  "description": "Taiga project management from Claude Code: sprints, backlog, issues and reports",
  "keywords": ["taiga", "project-management", "agile", "scrum"],
  "mcpServers": {
    "taiga": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/dist/index.js"],
      "env": {
        "TAIGA_URL": "${TAIGA_URL}",
        "TAIGA_USERNAME": "${TAIGA_USERNAME}",
        "TAIGA_PASSWORD": "${TAIGA_PASSWORD}",
        "TAIGA_PROJECT": "${TAIGA_PROJECT:-}"
      }
    }
  }
}
