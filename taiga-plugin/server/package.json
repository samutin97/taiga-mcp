{
  "name": "taiga-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "test": "vitest run && node --test ../scripts/*.test.mjs",
    "test:server": "vitest run",
    "test:scripts": "node --test ../scripts/*.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:eval-regex": "node ../scripts/gen-eval-regex.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
